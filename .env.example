# Copier ce fichier en `.env` puis ajuster les valeurs. Voir docs/12-deploiement.md.

NODE_ENV=development
APP_NAME="FSF Accreditation"
APP_PORT=3000
APP_GLOBAL_PREFIX=api
APP_DEFAULT_API_VERSION=1
APP_PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Base de donnees ---
# Port 5433 cote hote (voir docker-compose.yml) pour eviter tout conflit avec
# une instance PostgreSQL native deja installee sur le poste (port 5432).
DATABASE_URL="postgresql://fsf:fsf@localhost:5433/fsf_accreditation?schema=public"
DATABASE_LOG_QUERIES=false

# --- Redis / cache / files (BullMQ) ---
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=fsf:
CACHE_DEFAULT_TTL_SECONDS=60

# --- Authentification ---
# Generer des secrets forts : `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
JWT_REFRESH_TTL=30d
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2

# Secret HMAC pour le hachage des jetons QR d'accreditation (jamais le jeton en clair en base)
QR_TOKEN_SECRET=change-me-qr-token-secret-min-16-chars

# Cle privee EC P-256 (PEM) pour la signature ECDSA des badges (verification
# hors-ligne aux postes de controle, cahier §18). Generer avec :
#   openssl ecparam -name prime256v1 -genkey -noout
# Coller le PEM multi-lignes tel quel entre guillemets (dotenv le supporte),
# ou sur une seule ligne avec les retours a la ligne echappes en "\n".
ECDSA_PRIVATE_KEY_PEM="-----BEGIN EC PRIVATE KEY-----\nchange-me\n-----END EC PRIVATE KEY-----"

# --- Stockage documentaire (S3-compatible : MinIO en local) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=fsf-documents
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PRESIGN_TTL_SECONDS=300
STORAGE_MAX_FILE_SIZE_MB=10
STORAGE_ALLOWED_MIME=application/pdf,image/jpeg,image/png,image/webp

# --- Email (SMTP - Mailpit en local sur http://localhost:8025) ---
MAIL_FROM="FSF Accreditation <no-reply@fsf.sn>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# --- SMS/WhatsApp (non active par defaut, cf. cahier des charges §20) ---
SMS_ENABLED=false

# --- Observabilite ---
LOG_LEVEL=info
LOG_PRETTY=true
METRICS_ENABLED=true

# --- Limitation de debit ---
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
